{
  "show_network_list": false,
  "networks": [
    {
      "id": "ssh_direct_1",
      "name": "SSH Direct (no payload)",
      "info": "Plain SSH, Custom Payload off",
      "tunnel_type": "SSH_DIRECT",
      "server": "1.2.3.4",
      "port": "22",
      "user": "myuser",
      "pass": "mypass"
    },
    {
      "id": "ssh_direct_2",
      "name": "SSH Direct + Payload",
      "info": "Custom Payload on",
      "tunnel_type": "SSH_DIRECT",
      "server": "1.2.3.4",
      "port": "22",
      "user": "myuser",
      "pass": "mypass",
      "payload": "GET / HTTP/1.1[crlf]Host: example.com[crlf][crlf]"
    },
    {
      "id": "ssh_proxy_1",
      "name": "SSH HTTP Proxy",
      "info": "Payload through HTTP proxy",
      "tunnel_type": "SSH_PROXY",
      "server": "1.2.3.4",
      "port": "22",
      "user": "myuser",
      "pass": "mypass",
      "proxy_ip": "5.6.7.8",
      "proxy_port": "8080",
      "payload": "CONNECT [host_port] HTTP/1.1[crlf]Host: example.com[crlf][crlf]"
    },
    {
      "id": "ssh_ssl_1",
      "name": "SSH SSL / TLS",
      "info": "SSL tunnel with SNI",
      "tunnel_type": "SSH_SSL",
      "server": "1.2.3.4",
      "port": "443",
      "user": "myuser",
      "pass": "mypass",
      "sni": "example.com"
    },
    {
      "id": "ssl_payload_1",
      "name": "SSH SSL Payload",
      "info": "SSL with SNI and payload",
      "tunnel_type": "SSL_PAYLOAD",
      "server": "1.2.3.4",
      "port": "443",
      "user": "myuser",
      "pass": "mypass",
      "sni": "example.com",
      "payload": "GET / HTTP/1.1[crlf]Host: example.com[crlf][crlf]"
    },
    {
      "id": "ssl_proxy_1",
      "name": "SSH SSL Proxy",
      "info": "SSL + proxy + payload",
      "tunnel_type": "SSL_PROXY",
      "server": "1.2.3.4",
      "port": "443",
      "user": "myuser",
      "pass": "mypass",
      "sni": "example.com",
      "proxy_ip": "5.6.7.8",
      "proxy_port": "8080",
      "payload": "CONNECT [host_port] HTTP/1.1[crlf]Host: example.com[crlf][crlf]"
    },
    {
      "id": "udp_1",
      "name": "Hysteria / UDP",
      "info": "UDP tunnel",
      "tunnel_type": "UDP",
      "udp_server": "1.2.3.4",
      "udp_port": "20000-50000",
      "udp_auth": "authpassword",
      "udp_obfs": "obfspassword",
      "udp_up": "100",
      "udp_down": "100"
    },
    {
      "id": "slowdns_1",
      "name": "SlowDNS",
      "info": "DNS tunnel",
      "tunnel_type": "SLOWDNS",
      "nameserver": "ns.example.com",
      "chave": "your_public_key_here",
      "dns_server": "8.8.8.8",
      "user": "myuser",
      "pass": "mypass"
    },
    {
      "id": "v2ray_uri_1",
      "name": "V2Ray (URI)",
      "info": "vless / vmess / trojan link",
      "tunnel_type": "V2RAY",
      "v2ray_json": "vmess:"
    },
    {
      "id": "itv_remote_1",
      "name": "Remote .itv Config",
      "info": "Downloads and imports a config file",
      "config_url": "https://raw.githubusercontent.com/your-username/your-repo/main/configs/example.itv"
    }
  ]
}
